NEXT_PUBLIC_SMART_ACCOUNT_ADAPTER_ADDRESS=0x78a5258dB533F8Ac986668DfFEB05019819eeC79

# Web3Auth Embedded Wallet Configuration
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet
# use sapphire_mainnet for production

# ERC-4337 Bundler Configuration (for Smart Account user operations)
# Get API key from https://dashboard.pimlico.io or use another bundler
NEXT_PUBLIC_BUNDLER_RPC_URL=https://api.pimlico.io/v2/421614/rpc?apikey=your-pimlico-api-key
# Alternatives: Stackup (https://www.stackup.sh/), Alchemy, Biconomy

# x402 Payment Protocol
X402_ENABLED=true
X402_PAY_TO=0xYourFeeRecipient
X402_BOUNTY_CREATE_PRICE_USDC=0.10
X402_TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
X402_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# 1Shot Gasless Relayer
ONESHOT_API_KEY=your_oneshot_api_key
ONESHOT_API_SECRET=your_oneshot_api_secret
ONESHOT_BUSINESS_ID=your_business_id
ONESHOT_WEBHOOK_PUBLIC_KEY=your_webhook_public_key
ONESHOT_RELEASE_METHOD_ID=your_method_id

# Venice AI (Code Review)
VENICE_API_KEY=your_venice_api_key

# Database and Redis
DATABASE_URL=postgresql://user:password@localhost:5432/praises
REDIS_URL=redis://localhost:6379

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN=your_github_personal_access_token

# Relayer API (Legacy - for backward compatibility)
PORT=3100
CHAIN=arbitrum-sepolia

